{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "dua-kelinci-sales-ui-tokens",
  "version": "1.0.0",
  "source": "Approved Dua Kelinci dashboard visual reference; refer to frontend-design.json for layout and behavior",
  "theme": {
    "mode": "light",
    "colors": {
      "brandPrimary": "#C51F2D",
      "brandPrimaryHover": "#A91926",
      "brandSoft": "#FCEBED",
      "brandBorder": "#F3D5D9",
      "background": "#F7F8FA",
      "surface": "#FFFFFF",
      "surfaceMuted": "#F9FAFB",
      "textPrimary": "#181B22",
      "textSecondary": "#5D6472",
      "textMuted": "#858D9A",
      "border": "#E6E8EC",
      "chartRed": "#CB2433",
      "chartRedMedium": "#DE5660",
      "chartRedLight": "#EE9299",
      "chartRedPale": "#F5C4C8",
      "chartGray": "#D5D8DD",
      "success": "#248547",
      "error": "#C62828"
    },
    "typography": {
      "fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
      "pageTitle": {
        "fontSizePx": 30,
        "fontWeight": 700,
        "lineHeight": 1.2
      },
      "pageSubtitle": {
        "fontSizePx": 16,
        "fontWeight": 400
      },
      "sectionTitle": {
        "fontSizePx": 20,
        "fontWeight": 700
      },
      "metricValue": {
        "fontSizePx": 27,
        "fontWeight": 700,
        "fontVariantNumeric": "tabular-nums"
      },
      "body": {
        "fontSizePx": 14,
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "label": {
        "fontSizePx": 13,
        "fontWeight": 500
      },
      "caption": {
        "fontSizePx": 12,
        "fontWeight": 400
      }
    },
    "spacing": {
      "baseUnitPx": 8,
      "pagePaddingPx": 24,
      "cardPaddingPx": 24,
      "gridGapPx": 20,
      "sectionGapPx": 22
    },
    "shape": {
      "cardRadiusPx": 14,
      "controlRadiusPx": 9,
      "pillRadiusPx": 999,
      "borderWidthPx": 1
    },
    "shadow": "0 2px 12px rgba(20, 25, 35, 0.035)",
    "icons": {
      "sizePx": 20,
      "strokeWidth": 1.9
    }
  },
  "brand": {
    "logoSvg": "/assets/brand/dua-kelinci-concept-transparent.svg",
    "logoPng": "/assets/brand/dua-kelinci-concept-transparent.png",
    "logoStatus": "illustrative recreation—not official logo"
  },
  "icons": {
    "directory": "/assets/icons/",
    "format": "SVG",
    "sizePx": 20,
    "stroke": "currentColor",
    "strokeWidth": 1.9
  }
}
